# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# Admin dashboard login (visit /admin)
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password

# Optional: email notification whenever a new lead comes in.
# If left blank, leads are still saved to the database — you just won't get
# an email. Any standard SMTP provider works (Gmail, Zoho, SendGrid, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
